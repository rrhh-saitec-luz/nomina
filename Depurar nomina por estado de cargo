3.- Unificamos los cargos por cedulas de identidad, creando un hash @cargos_trabajador, sera una variable global que igualaremos a al metodo colectar_cargos en admins_concerns pasando la variable nomina_actual

@cargos_trabajador = colectar_cargos(nomina_actual)

4.- el metodo colectar_cargos debe devolver un hash tranformando los valores que se desean

def colectar_cargos(cargos)
  coleccion = {}
  cargos.each do |t|
    if coleccion.key?(t[0])
      coleccion[t[0]][:cargos] << [t[2], t[3]]
    else
      coleccion[t[0]] = { cedula: t[0], nombre: t[1], cargos: [[t[2], t[3]]] }
    end
  end
  coleccion
end

