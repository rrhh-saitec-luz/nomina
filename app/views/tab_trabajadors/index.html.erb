<div class="container-fluid mt-4">
  
  <%# Tarjeta de Búsqueda %>
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
      <div class="d-flex align-items-center mb-3 text-secondary">
        <i class="bi bi-search fs-4 me-2"></i>
        <h5 class="card-title mb-0 fw-bold">Buscar Personal en el Sistema</h5>
      </div>
      
      <%= form_with url: tab_trabajadors_path, method: :get, local: true, class: 'row g-2 justify-content-center' do %>
        <div class="col-12 col-md-8 col-lg-6">
          <div class="input-group">
            <span class="input-group-text bg-light text-secondary border-end-0">
              <i class="bi bi-card-id fs-5"></i>
            </span>
            <%= text_field_tag :q, @search_term, 
                placeholder: "Ingrese cédula de identidad...", 
                class: "form-control border-start-0 py-2.5 ps-0 shadow-none focus-ring", 
                style: "--bs-focus-ring-color: rgba(var(--bs-dark-rgb), .1)" %>
            <%= submit_tag "Buscar", class: "btn btn-dark px-4 fw-semibold" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Contenedor de Resultados o Estado Inicial %>
  <div class="card shadow-sm border-0 overflow-hidden">
    <% if @sidial.nil? %>
      
      <%# Estado Inicial: Esperando búsqueda %>
      <div class="card-body text-center py-5">
        <div class="text-muted mb-3">
          <i class="bi bi-person-search display-3 opacity-50"></i>
        </div>
        <h4 class="fw-bold text-dark mb-1">¡Realiza una búsqueda para comenzar!</h4>
        <p class="text-secondary mb-0 small">Digita la cédula de identidad del trabajador en la barra superior.</p>
      </div>

    <% else %>
      
      <%# Encabezado del listado obtenido %>
      <div class="card-header bg-dark text-white d-flex align-items-center py-3">
        <i class="bi bi-person-lines-fill me-2 fs-4"></i>
        <h5 class="card-title mb-0 fw-bold">Resultados de la Búsqueda</h5>
        <span class="badge bg-light text-dark ms-auto fw-medium px-2.5"><%= @sidial.size %> Registro(s)</span>
      </div>

      <%# Tabla de Resultados %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light text-secondary text-uppercase tracking-wider small">
            <tr>
              <th scope="col" class="ps-4">Cédula</th>
              <th scope="col">Nombres y Apellidos</th>
              <th scope="col">Estatus de Cargo</th>
              <th scope="col">Tipo Personal</th>
              <th scope="col">Descripción Cargo</th>
              <th scope="col" class="text-end pe-4">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @sidial.each do |trabajador| %>
              <tr>
                <%# Cédula %>
                <td class="ps-4 fw-semibold text-dark">
                  <%= trabajador.ce_trabajador %>
                </td>
                
                <%# Nombres %>
                <td>
                  <div class="fw-bold text-dark"><%= trabajador.nombres.titleize %></div>
                </td>
                
                <%# Estatus (con Badge condicional) %>
                <td>
                  <% estatus = @desc_estatus[trabajador.edo_cargo] %>
                  <% color_badge = trabajador.edo_cargo.to_s == 'A' ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary' %>
                  <span class="badge <%= color_badge %> px-2.5 py-1.5 fw-semibold border border-opacity-10">
                    <%= estatus %>
                  </span>
                </td>
                
                <%# Tipo de Personal %>
                <td>
                  <div class="small fw-semibold text-dark mb-0"><%= trabajador.tipopersonal %></div>
                  <div class="text-secondary extra-small text-muted" style="font-size: 0.75rem;"><%= trabajador.descripcion_tp %></div>
                </td>
                
                <%# Descripción Cargo %>
                <td class="text-secondary small">
                  <%= trabajador.descripcion_cargo %>
                </td>
                
                <%# Columna de Acciones (Botones estilizados) %>
                <td class="text-end pe-4">
                  <div class="d-inline-flex gap-2">
                    
                    <%= link_to tab_trabajador_path(id: trabajador.id), 
                        class: 'btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 px-2.5 py-1.5', 
                        title: 'Detalle de cargo' do %>
                      <i class="bi bi-eye fs-6"></i>
                      <span class="d-none d-xl-inline small fw-medium">Detalle</span>
                    <% end %>

                    <%= link_to pago_path(CE_TRABAJADOR: trabajador.ce_trabajador, 
                                          CO_UBICACION: trabajador.co_ubicacion.strip, 
                                          TIPOPERSONAL: trabajador.tipopersonal.strip, 
                                          id: trabajador.id), 
                        class: 'btn btn-sm btn-outline-primary d-flex align-items-center gap-1 px-2.5 py-1.5', 
                        title: 'Pagos trabajador' do %>
                      <i class="bi bi-cash-stack fs-6"></i>
                      <span class="d-none d-xl-inline small fw-medium">Pagos</span>
                    <% end %>

                    <%= link_to variacion_path(id: trabajador.id), 
                        class: 'btn btn-sm btn-outline-dark d-flex align-items-center gap-1 px-2.5 py-1.5', 
                        title: 'Variaciones trabajador' do %>
                      <i class="bi bi-sliders fs-6"></i>
                      <span class="d-none d-xl-inline small fw-medium">Variaciones</span>
                    <% end %>

                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

    <% end %>
  </div>
</div>

