<%# Tu partial existente con soporte para acciones %>
<div class="card shadow-sm mb-4 border-0">                                            
  <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">         
    <div class="d-flex align-items-center">
      <i class="bi bi-person-badge me-2 fs-4"></i>                                                                             
      <h5 class="card-title mb-0 fw-bold">Datos del Trabajador</h5>                     
    </div>
    
    <%# Si se definen acciones al llamar al partial, se muestran aquí %>
    <% if local_assigns[:acciones] %>
      <div class="d-flex gap-2">
        <%= acciones %>
      </div>
    <% end %>
  </div>                                                                                
  
  <ul class="list-group list-group-flush">                                              
    <% @presenter.datos_personales.each do |key, val| %>                              
      <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">                                                                                
        <span class="text-secondary fw-semibold small text-uppercase tracking-wider"> 
          <%= key.delete(':') %> 
        </span>                                                                       
        <span class="text-dark fw-bold fs-6">                                         
          <%= val %>                                                                  
        </span>              
      </li>                                                                           
    <% end %>                                                                         
  </ul>                                                                               
</div>

