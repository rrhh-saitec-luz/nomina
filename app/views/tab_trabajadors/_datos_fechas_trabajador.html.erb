<div class="card shadow-sm mb-4 border-0">
  <div class="card-header bg-dark text-white d-flex align-items-center py-3">
    <i class="bi bi-calendar3 me-2 fs-4"></i>
    <h5 class="card-title mb-0 fw-bold">Fechas del Trabajador</h5>
  </div>

  <% # Bloque Administrativo %>
  <ul class="list-group list-group-horizontal-lg text-center bg-light fw-bold small text-uppercase tracking-wider border-bottom">
    <li class="list-group-item flex-fill bg-dark text-white border-0 py-1">Estatus Administrativo</li>
  </ul>
  <ul class="list-group list-group-horizontal-lg border-0">                                      
    <%= render 'fechas', lista_fechas: @presenter.fechas_adm_cargo, extra_titulo: 'Turno', extra_valor: @presenter.turno_actual %>                                               
  </ul>                                                                                 

  <% # Bloque del Cargo %>
  <ul class="list-group list-group-horizontal-lg text-center bg-light fw-bold small text-uppercase tracking-wider border-bottom mt-2">
    <li class="list-group-item flex-fill bg-dark text-white border-0 py-1">Estatus del Cargo</li>
  </ul>
  <ul class="list-group list-group-horizontal-lg border-0">                  
    <%= render 'fechas', lista_fechas: @presenter.fechas_gral_cargo, extra_titulo: 'Años de Servicios', extra_valor: @presenter.antiguedad %>                                               
  </ul>
</div>

