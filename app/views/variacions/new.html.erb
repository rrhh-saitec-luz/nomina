<div class="card shadow-sm mb-4 border-0">
  <%# Encabezado de la tarjeta con el diseño oscuro e icono %>
  <% if notice.present? %>
    <p><%= notice %></p>
  <% end %>
  <% if @variacion.errors.any? %>
  <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
    <div class="d-flex align-items-center">
      <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
      <strong>Por favor corrige los siguientes errores:</strong>
    </div>
    <ul class="mb-0 mt-2 ps-3">
      <% @variacion.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>
<div class="card shadow-sm mb-4 border-0">
  <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
    <div class="d-flex align-items-center">
      <i class="bi bi-file-earmark-medical me-2 fs-4"></i>
      <h5 class="card-title mb-0 fw-bold">Nueva Variación de Concepto</h5>
    </div>
  </div>

  <%# Contenedor del formulario dentro del cuerpo de la tarjeta %>
  <div class="card-body bg-light">
    <%= form_with model: @variacion, 
                  data: { controller: "varconcepto" }, 
                  local: true, 
                  class: "d-flex flex-column col-12 gap-3" do |form| %>
                  
      <%= render "cabecera_variacion", trab: @trab %>
      <%= render "accion", form: form %>
      <%= render "seleccion_concepto", form: form, con: @con %>
      <%= render "beneficiario", form: form %>
      <%= render "tipo_nomina", form: form, tipo_nomina: @tipo_nomina %>
      <%= render "nomina_especifica", form: form %>
      <%= render "fechas_nomina", form: form %>
      <%= render "montos", form: form %>

      <%# Campos ocultos %>
      <%= form.hidden_field :ce_trabajador, value: @trab.ce_trabajador %>
      <%= form.hidden_field :co_ubicacion, value: @trab.co_ubicacion %>
      <%= form.hidden_field :tipopersonal, value: @trab.tipopersonal %>
      <%= form.hidden_field :descripcion_tp, value: @trab.descripcion_tp %>
      <%= form.hidden_field :id_trabajador, value: @trab.id %>
      <%= form.hidden_field :usuario, value: current_user.nombre %>
      <%= form.hidden_field :in_nomina, value: @estatus %>

      <%# Botón de acción alineado al centro %>
      <%= form.submit "Crear", class: "btn btn-dark col-md-2 align-self-center mt-3 shadow-sm" %>
    <% end %>
  </div>
</div>

