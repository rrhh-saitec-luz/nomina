<%= variaciones.present? %>
<%= variaciones.count %>
<% i = 1 %>
<table class="table">
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">First</th>
      <th scope="col">Last</th>
      <th scope="col">Handle</th>
    </tr>
  </thead>
  <tbody>
    <% variaciones.each do |variacion| %>
    <tr>
      <th scope="row"><%= i %></th>
      <td><%= variacion.co_concepto %></td>
      <td><%= variacion.co_concepto %></td>
      <td><%= variacion.co_concepto %></td>
    </tr>
    <% i += 1 %>
    <% end %>
  </tbody>
</table>
