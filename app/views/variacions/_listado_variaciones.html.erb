<% i = 1 %>
<table class="table table-bordered border-primary">
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">código</th>
      <th scope="col">Descripción</th>
      <th scope="col">Eliminar</th>
    </tr>
  </thead>
  <tbody>
    <% variaciones.each do |variacion| %>
    <tr>
      <th scope="row"><%= i %></th>
      <td><%= variacion.co_concepto %></td>
      <td><%= variacion.descripcion_co %></td>
      <% if variacion.status.eql?(false) %>
        <td>
          <%= button_to "Eliminar",
            { action: "destroy", id: variacion.id }, method: :delete, data: { confirm: "Seguro?" }, class: "btn btn-danger" %>
        </td>
      <% else %>
        <td>---</td>
      <% end %>
    </tr>
    <% i += 1 %>
    <% end %>
  </tbody>
</table>
