<div class="container-fluid mt-4">

    <%# Banner de Bienvenida Principal %>
  <div class="card shadow-sm border-0 mb-4 bg-dark text-white overflow-hidden">
    <div class="card-body p-4 d-flex align-items-center justify-content-between position-relative">
      <div>
        <h3 class="fw-bold mb-1">
          ¡Bienvenido al Sistema, <%= "#{current_user.nombre} #{current_user.apellido}".strip.titleize %>! 👋
        </h3>
        <p class="text-white-50 mb-0">Selecciona una de las opciones principales para comenzar a gestionar tu información.</p>
      </div>
      <i class="bi bi-rocket-takeoff text-white-50 fs-1 d-none d-sm-block opacity-25"></i>
    </div>
  </div>
  
  <%# Rejilla de Accesos Rápidos %>
  <div class="row g-3">
    
    <%# Opción: Trabajadores %>
    <div class="col-12 col-md-6 col-lg-4">
      <div class="card shadow-sm border-0 h-100 card-hover-effect">
        <div class="card-body d-flex flex-column p-4">
          <div class="d-flex align-items-center mb-3">
            <div class="bg-primary bg-opacity-10 text-primary rounded p-3 me-3">
              <i class="bi bi-people fs-3"></i>
            </div>
            <h5 class="card-title mb-0 fw-bold text-dark">Trabajadores</h5>
          </div>
          <p class="text-secondary small flex-grow-1">
            Gestiona la información del personal, consulta datos de cargos, estatus, contratos y registros activos.
          </p>
          <%= link_to tab_trabajadors_path, class: "btn btn-outline-primary w-100 d-flex align-items-center justify-content-center gap-2 mt-2" do %>
            <span>Ingresar</span>
            <i class="bi bi-arrow-right-short fs-5"></i>
          <% end %>
        </div>
      </div>
    </div>

    <%# Opción: Administrar (Condicional según Rol) %>
    <% if current_user.rol.eql?("admin") %>
      <div class="col-12 col-md-6 col-lg-4">
        <div class="card shadow-sm border-0 h-100 card-hover-effect">
          <div class="card-body d-flex flex-column p-4">
            <div class="d-flex align-items-center mb-3">
              <div class="bg-dark bg-opacity-10 text-dark rounded p-3 me-3">
                <i class="bi bi-gear fs-3"></i>
              </div>
              <h5 class="card-title mb-0 fw-bold text-dark">Administración</h5>
            </div>
            <p class="text-secondary small flex-grow-1">
              Panel exclusivo para administradores. Configura parámetros globales, roles, permisos y seguridad.
            </p>
            <%= link_to admins_path, class: "btn btn-outline-dark w-100 d-flex align-items-center justify-content-center gap-2 mt-2" do %>
              <span>Configurar</span>
              <i class="bi bi-arrow-right-short fs-5"></i>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%# Opción Extra: Soporte o Mi Perfil (Ejemplo de relleno útil) %>
    <div class="col-12 col-md-6 col-lg-4">
      <div class="card shadow-sm border-0 h-100 card-hover-effect">
        <div class="card-body d-flex flex-column p-4">
          <div class="d-flex align-items-center mb-3">
            <div class="bg-secondary bg-opacity-10 text-secondary rounded p-3 me-3">
              <i class="bi bi-person-badge fs-3"></i>
            </div>
            <h5 class="card-title mb-0 fw-bold text-dark">Mi Cuenta</h5>
          </div>
          <p class="text-secondary small flex-grow-1">
            Revisa tus datos de sesión actuales, rol asignado dentro de la plataforma y opciones de seguridad.
          </p>
          <div class="text-muted small mt-2 bg-light p-2 rounded text-center border">
            Rol actual: <span class="badge bg-secondary"><%= current_user.rol.upcase %></span>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

