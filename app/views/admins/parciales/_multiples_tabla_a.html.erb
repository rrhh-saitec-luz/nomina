<% i = 1 %>
<%= content_tag :table, class:" table table-info align-middle" do %>
  <%= content_tag :thead do %>
    <%= content_tag :tr do %>
      <%= content_tag :th, scope: "col" do %>#<% end %>
      <%= content_tag :th, scope: "col" do %>Cedula<% end %>
      <%= content_tag :th, scope: "col" do %>nombre<% end %>
      <%= content_tag :th, scope: "col" do %>cargos<% end %>
    <% end %>
  <% end %>
  <%= content_tag :tbody do %>
    <% @cargos_trabajador.each do |id, info|%>
      <%= content_tag :tr do %>
        <%= content_tag :th, scope: "row" do %><%= i %><% end %>
        <%= content_tag :td do %><%= info[:cedula] %><% end %>
        <%= content_tag :td do %><%= info[:nombre] %><% end %>
        <%= content_tag :td do %>
          <%= render "admins/parciales/multiples_tabla_b",
              cargos: info[:cargos].sort,
              cedula: info[:cedula],
              cargos_prenomina: @cargos_prenomina %>
        <% end %>
        <% i += 1 %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
