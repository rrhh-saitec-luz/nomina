<turbo-frame id="contenido">
  <% if @contador.eql?(4) %>
    <%= form_with url: suma_asigna_admins_path,
                  class: "d-flex flex-column mt-3 gap-3 justify-content-center" do |form|  %>
      <h5 class= "text-center"> Ingrese fecha de la nomina </h5>
      <%= form.hidden_field :personas,  value: @personal %>
      <%= form.label :fe_nomina, "Fecha nomina" %>
      <%= fore.date_field :fe_nomina, require: true %>
      <%= form.submit "Calcular", class: "btn btn-primary" %>
    <% end %>
  <% else %>
    <%= content_tag :h1 do %>
      "Hola Mundo"
    <% end %>
  <% end %>
</turbo-frame>
