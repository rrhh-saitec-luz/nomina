<div id="progreso_cargos_<%= tipo %>"> 
  <div class="progress">
    <div class="progress-bar progress-bar-striped progress-bar-animated bg-warning text-dark" 
         role="progressbar" 
         style="width: <%= porcentaje %>%">
      <%= porcentaje %>%
    </div>
  </div>
  <p class="text-center small fw-bold">
    Sincronizando cargos: <%= procesados %> de <%= total %> procesados...
  </p>
</div>
