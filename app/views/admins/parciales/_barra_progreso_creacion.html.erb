<div id="progreso_cargos_creacion" class="w-100 animate__animated animate__fadeIn">
  <div class="d-flex justify-content-between align-items-center mb-1 small text-muted">
    <span><i class="bi bi-database-add text-success"></i> Generando prenómina...</span>
    <strong><%= procesados %> / <%= total %> registros</strong>
  </div>
  
  <div class="progress" style="height: 20px;">
    <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" 
         role="progressbar" 
         style="width: <%= porcentaje %>%;" 
         aria-valuenow="<%= porcentaje %>" 
         aria-valuemin="0" 
         aria-valuemax="100">
      <%= porcentaje %>%
    </div>
  </div>
</div>

