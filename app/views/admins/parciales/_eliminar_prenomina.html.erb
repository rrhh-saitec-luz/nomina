<turbo-frame id="contenido">
  <%= content_tag :h5, class: "d-flex flex-column mt-3 gap-3 text-success text-center" do %>
    Ya generó una prenomina. ¿Desea Eliminarla?                                     
  <% end %>
  <%= content_tag :ol, class: "d-flex flex-column gap-3" do %>
  <li>
    <div class="d-flex flex-row gap-3">
      <%= button_to 'Eliminar Prenomina',
                    destruir_prenomina_admins_path,
                    class: "btn btn-danger" %>
    </div>
  </li>
  <% end %>  
</turbo-frame>
