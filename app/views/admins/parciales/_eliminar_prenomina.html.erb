<turbo-frame id="contenido">                                                                                         
  <div class="card-body p-4 text-center py-5">
    
    <%# Icono de Advertencia de Estado %>
    <div class="mb-3 text-warning">
      <i class="bi bi-exclamation-triangle display-3 opacity-75"></i>
    </div>
    
    <%# Mensaje Principal %>
    <h4 class="fw-bold text-dark mb-2">Proceso de Prenómina Activo</h4>
    <p class="text-secondary mx-auto mb-4 small" style="max-width: 420px;">
      El sistema detectó que ya se encuentra una prenómina generada en este período. Para iniciar un proceso nuevo, es necesario remover la actual.
    </p>

    <%# Contenedor del Botón de Acción %>
    <div class="d-flex justify-content-center align-items-center gap-3">
      <%= button_to destruir_prenomina_admins_path, 
                    method: :post,
                    class: "btn btn-danger px-4 py-2 fw-semibold shadow-sm d-inline-flex align-items-center gap-2",
                    data: { turbo_confirm: "¿Está completamente seguro de eliminar la prenómina actual? Esta acción no se puede deshacer." } do %>
        <i class="bi bi-trash3 fs-5"></i>
        <span>Eliminar Prenómina Activa</span>
      <% end %>
    </div>

  </div>
</turbo-frame>

