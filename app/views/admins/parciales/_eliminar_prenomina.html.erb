<turbo-frame id="contenido">
  <%= turbo_stream_from 'nomina_channel' %>
  <%
  # 🌟 PROGRAMACIÓN DEFENSIVA: Extrae el contador de la variable local del Job o de la de instancia del controlador
  contador_objeto = local_assigns[:contador_local] || @contador
  fase_actual = contador_objeto.respond_to?(:valor) ? contador_objeto.valor.to_i : contador_objeto.to_i
%>

<%# 🌟 CAJA UNIFICADA CON BORDE SUAVE, SOMBRA Y MÁXIMO ANCHO CONTROLADO %>
<div class="text-center py-5 bg-light rounded-3 border <%= fase_actual >= 8 ? 'border-success' : 'border-warning' %> border-opacity-10 mx-auto shadow-sm" style="max-width: 500px;">

  <% if fase_actual >= 8 %>
    <%# Estado Post-Cierre: Éxito e Instrucción de Reinicio %>
    <div class="text-success mb-3">
      <i class="bi bi-archive-fill display-3 opacity-75"></i>
    </div>
    <h5 class="fw-bold text-dark mb-1">Cierre de Período Consolidado</h5>
    <p class="text-muted small mb-4 px-4">
      La información fiscal de este mes ha sido migrada con éxito a <code>Concepto</code>. La tabla de trabajo ya puede ser vaciada de forma segura para abrir el ciclo del mes siguiente.
    </p>
  <% else %>
    <%# Estado Intermedio: Advertencia de Proceso Abierto %>
    <div class="text-warning mb-3">
      <i class="bi bi-exclamation-triangle-fill display-3 opacity-75"></i>
    </div>
    <h5 class="fw-bold text-dark mb-1">Proceso de Prenómina Activo</h5>
    <p class="text-secondary small mb-4 px-4">
      El sistema detectó un cálculo base en la Fase <%= fase_actual %>. Para inicializar un proceso de datos completamente nuevo, es necesario remover la actual de la memoria volátil.
    </p>
  <% end %>

  <%# Contenedor del Botón Maestro de Destrucción Transaccional %>
  <div class="d-flex flex-column align-items-center justify-content-center gap-3 px-4">
    <%= button_to destruir_prenomina_admins_path,
                  method: :post,
                  class: "btn btn-danger px-4 py-2.5 fw-bold shadow-sm w-100 d-inline-flex align-items-center justify-content-center gap-2",
                  data: { turbo_confirm: fase_actual >= 8 ? "¿Desea vaciar el espacio de trabajo 'HistoricoPago' para dar inicio a un nuevo mes contable?" : "¿Está completamente seguro de eliminar la prenómina actual? Esta acción no se puede deshacer y borrará los cálculos intermedios." } do %>
      <i class="bi bi-trash3-fill fs-5"></i>
      <span><%= fase_actual >= 8 ? "Vaciar Canal y Reabrir Sistema" : "Eliminar Prenómina Activa" %></span>
    <% end %>
  </div>

  <%# ETIQUETAS DE ESTADO UNIFICADAS %>
  <div class="d-flex justify-content-center gap-2 mt-4">
    <span class="badge <%= fase_actual >= 8 ? 'bg-success-subtle text-success border-success' : 'bg-warning-subtle text-warning border-warning' %> border border-opacity-15 px-2.5 py-1.5 small fw-semibold">
      <i class="bi <%= fase_actual >= 8 ? 'bi-patch-check-fill' : 'bi-hourglass-split' %> me-1"></i>
      <%= fase_actual >= 8 ? "Historial Resguardado" : "Cálculo Abierto" %>
    </span>
    <span class="badge bg-light text-secondary border px-2 py-1.5 small fw-medium">
      Fase: <%= fase_actual %>
    </span>
  </div>

</div>

</turbo-frame>
