<div id="progreso_anticipos" class="w-100 animate__animated animate__fadeIn mt-3"> 
  <%# Etiquetas superiores con la identidad del X-500 %>
  <div class="d-flex justify-content-between align-items-center mb-2 small">                              
    <span class="text-success fw-semibold d-flex align-items-center gap-2">
      <i class="bi bi-cpu-fill fs-5 text-success"></i> 
      <span>Calculando anticipos X-500...</span>
    </span>                                
    <span class="badge bg-light text-dark border fw-medium px-2 py-1">
      <%= procesados %> / <%= total %> registros (<%= porcentaje %>%)
    </span>                                                      
  </div>                                                                                                             
                                                                                                                     
  <%# Barra de Progreso Minimalista %>
  <div class="progress position-relative shadow-inner mb-1" style="height: 12px; background-color: rgba(var(--bs-success-rgb), 0.1);">                                                                       
    <div class="progress-bar progress-bar-striped progress-bar-animated bg-success rounded-pill"                                    
         role="progressbar"                                                                                          
         style="width: <%= porcentaje %>%; transition: width 0.3s ease;"                                                                           
         aria-valuenow="<%= porcentaje %>"                                                                           
         aria-valuemin="0"                                                                                           
         aria-valuemax="100">                                                                                        
    </div>                                                                                                            
  </div>                                                                                                             
  
</div>
