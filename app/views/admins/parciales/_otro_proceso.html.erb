<turbo-frame id="contenido">
  <% if cont > 1 %>
    <%= content_tag :h5,
                    class: "d-flex flex-column mt-3 gap-3 justify-content-center text-success text-center" do %>
                    Ya usted actualizó la fecha de la prenomina. ¿Desea editarla?
    <% end %>
      <%= render "admins/parciales/modificar_prenomina_forma", meses: meses %>
  <% else %>
    <%= content_tag :h5,
                    class: "d-flex flex-column mt-3 gap-3 justify-content-center text-center" do %>
      Usted debe crear una prenomina primero
    <% end %>
  <% end %>
</turbo-frame>
