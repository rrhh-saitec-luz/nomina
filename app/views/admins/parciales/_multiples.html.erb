<turbo-frame id="contenido">
  <%= @cargos_trabajador %>

  <% i = 1 %>
  <% if cont.eql?(4) %>
    <%= content_tag :div, 
                    class: "d-flex flex-column mt-3 gap-3 justify-content-center" do %>
      <% if @cargos_trabajador.empty? %>
        <div>Cargos no encontrados</div>
      <% else %>


          <%= content_tag :table, class:" table table-info" do %>
            <%= content_tag :thead do %>
              <%= content_tag :tr do %>
                <%= content_tag :th, scope: "col" do %>#<% end %>
                <%= content_tag :th, scope: "col" do %>Cedula<% end %>
                <%= content_tag :th, scope: "col" do %>Ubicación<% end %>
                <%= content_tag :th, scope: "col" do %>Tipo de personal<% end %>
              <% end %>
            <% end %>




        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <%= content_tag :h1 do %>
      "Hola Mundo"
    <% end %>
  <% end %>
</turbo-frame>

