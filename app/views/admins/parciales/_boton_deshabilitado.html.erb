<%= content_tag :li, id: "contenedor_boton_#{tipo}" do %>
  <% tipo_boton = tipo == :unicos ? "Sincronizar cargos únicos" : "Detectar inconsistencias"%>
  
  <div class="d-flex flex-row gap-2">
    <button class='btn btn-warning' disabled>
      <%= tipo_boton %>
    </button>
    <%= content_tag :div,
                    id: "progreso_cargos_#{tipo}",
                    class: "align-self-center" do %>
    <% end %>
  </div>
<% end %>
