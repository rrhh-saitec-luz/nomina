<turbo-frame id="contenido">
  <%= turbo_stream_from 'nomina_channel' %>

  <div class="card-body p-4">

    <%# --- ENCABEZADO UNIFICADO: Solo cambia entre Verde y Rojo --- %>
    <div class="d-flex align-items-center gap-2 mb-4 pb-3 border-bottom <%= cont.to_i >= 8 ? 'text-danger' : 'text-success' %>">
      <i class="bi <%= cont.to_i >= 8 ? 'bi-shield-lock-fill' : 'bi-shield-check' %> fs-4"></i>
      <h5 class="mb-0 fw-bold">Asistente de Depuración de Nómina</h5>
    </div>

    <% if cont.to_i >= 8 %>

      <%# 🌟 ESCENARIO DE CLAUSURA FISCAL: Bloqueo absoluto e inmutable %>
      <div class="text-center py-5 bg-light rounded-3 border border-danger border-opacity-10 mx-auto shadow-sm" style="max-width: 500px;">
        <div class="text-danger mb-3">
          <i class="bi bi-shield-fill-check display-3 opacity-75"></i>
        </div>
        <h5 class="fw-bold text-dark mb-1">Módulo de Depuración Clausurado</h5>
        <p class="text-muted small mb-3 px-4">
          Este período de nómina ha sido procesado y archivado de forma inmutable. Los filtros de seguridad y depuración de cargos ya no se encuentran editables.
        </p>
        <div class="d-flex justify-content-center gap-2">
          <span class="badge bg-danger-subtle text-danger border border-danger border-opacity-15 px-2.5 py-1.5 small fw-semibold">
            <i class="bi bi-lock-fill me-1"></i> Período Consolidado
          </span>
          <span class="badge bg-light text-secondary border px-2 py-1.5 small fw-medium">
            Fase: <%= cont %>
          </span>
        </div>
      </div>

    <% elsif cont.to_i < 2 %>

      <%# Estado de Bloqueo Inicial (Mantiene tu parcial original) %>
      <div class="py-4">
        <%= render "admins/parciales/no_opciones_disponibles" %>
      </div>
    <% else %>

      <%# Banner de Estado Superior Inteligente %>
      <div class="alert mb-4 border-0 rounded-3 p-3 shadow-sm d-flex align-items-center gap-3 <%= cont.to_i >= 5 ? 'bg-success bg-opacity-10 text-success' : 'bg-dark bg-opacity-10 text-dark' %>" style="max-width: 650px; margin: 0 auto;">
        <i class="bi <%= cont.to_i >= 5 ? 'bi-check-circle-fill text-success' : 'bi-exclamation-circle-fill text-secondary' %> fs-4"></i>
        <div>
          <h6 class="mb-0 fw-bold small text-uppercase tracking-wider">Control de Calidad de Datos</h6>
          <p class="mb-0 extra-small opacity-75">
            <%= cont.to_i >= 5 ? "Depuración Terminada con Éxito" : "Depuración en paso activo: #{cont.to_i - 1}" %>
          </p>
        </div>
      </div>

      <%# Contenedor de la Línea de Tiempo %>
      <div class="d-flex flex-column gap-3 mx-auto mt-4" style="max-width: 650px;">

        <%# === PASO 2: SINCRONIZAR CARGOS ÚNICOS === %>
        <% if cont.to_i >= 2 %>
          <div class="p-3 bg-white border rounded-3 shadow-sm d-flex justify-content-between align-items-center" id="contenedor_boton_unicos">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle bg-light p-2.5 text-center <%= cont.to_i > 2 ? 'text-success' : 'text-muted' %>" style="width: 42px; height: 42px;">
                <i class="bi <%= cont.to_i > 2 ? 'bi-check-circle-fill' : 'bi-person-check' %> fs-5"></i>
              </div>
              <div>
                <h6 class="mb-0 fw-bold text-dark small">Paso 1: Sincronizar cargos únicos</h6>
                <p class="mb-0 text-muted extra-small">
                  <%= cont.to_i > 2 ? "✅ Sincronización Exitosa" : "Actualiza las plazas de un solo titular en el período actual." %>
                </p>
              </div>
            </div>
            <div>
              <%= button_to sincronizar_admins_path(tipo: 'unicos'),
                            disabled: !(cont.to_i == 2),
                            class: "btn #{cont.to_i == 2 ? 'btn-success' : 'btn-light border'} btn-sm fw-bold px-3 shadow-sm",
                            data: { disable_with: "Procesando...", turbo_submits_with: "Enviando..." } do %>
                <i class="bi bi-arrow-repeat me-1"></i> Sincronizar
              <% end %>
            </div>
          </div>
        <% end %>

        <%# === PASO 3: DETECTAR INCONSISTENCIAS MÚLTIPLES === %>
        <% if cont.to_i >= 3 %>
          <div class="p-3 bg-white border rounded-3 shadow-sm d-flex justify-content-between align-items-center" id="contenedor_boton_multiple">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle bg-light p-2.5 text-center <%= cont.to_i > 3 ? 'text-success' : 'text-muted' %>" style="width: 42px; height: 42px;">
                <i class="bi <%= cont.to_i > 3 ? 'bi-exclamation-triangle-fill text-warning' : 'bi-people' %> fs-5"></i>
              </div>
              <div>
                <h6 class="mb-0 fw-bold text-dark small">Paso 2: Detectar inconsistencias múltiples</h6>
                <p class="mb-0 text-muted extra-small d-flex align-items-center gap-2">
                  <%= cont.to_i > 3 ? "✅ Evaluado" : "Analiza colisiones de personal con doble cargo." %>
                  <% if cont.to_i >= 3 %>
                    <%= link_to vcm_admins_path, class: "text-decoration-none fw-semibold border-start ps-2 text-primary" do %>
                      <i class="bi bi-box-arrow-up-right me-1"></i> Manejar inconsistencias
                    <% end %>
                  <% end %>
                </p>
              </div>
            </div>
            <div>
              <%= button_to sincronizar_admins_path(tipo: 'multiple'),
                            disabled: !(cont.to_i == 3),
                            class: "btn #{cont.to_i == 3 ? 'btn-success' : 'btn-light border'} btn-sm fw-bold px-3 shadow-sm",
                            data: { disable_with: "Procesando...", turbo_submits_with: "Enviando..." } do %>
                <i class="bi bi-shield-radar me-1"></i> Detectar
              <% end %>
            </div>
          </div>
        <% end %>

        <%# === PASO 4: DEPURAR TRABAJADORES INACTIVOS === %>
        <% if cont.to_i >= 4 %>
          <div class="p-3 bg-white border rounded-3 shadow-sm d-flex justify-content-between align-items-center" id="contenedor_boton_inactivos">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle bg-light p-2.5 text-center <%= cont.to_i > 4 ? 'text-success' : 'text-danger' %>" style="width: 42px; height: 42px;">
                <i class="bi <%= cont.to_i > 4 ? 'bi-trash-fill text-muted' : 'bi-person-x-fill' %> fs-5"></i>
              </div>
              <div>
                <h6 class="mb-0 fw-bold text-dark small">Paso 3: Depurar trabajadores inactivos</h6>
                <p class="mb-0 text-muted extra-small">
                  <%= cont.to_i > 4 ? "✅ Depuración completada con éxito" : "Elimina de la pre-nómina los registros de personal dado de baja." %>
                </p>
              </div>
            </div>
            <div>
              <%= button_to sincronizar_admins_path(tipo: 'inactivos'),
                            disabled: !(cont.to_i == 4),
                            class: "btn #{cont.to_i == 4 ? 'btn-danger' : 'btn-light border'} btn-sm fw-bold px-3 shadow-sm",
                            data: { 
                              confirm: "¿Está seguro de que desea eliminar todos los registros inactivos? Esta acción no se puede deshacer.",
                              disable_with: "Procesando...",
                              turbo_submits_with: "Enviando..."
                            } do %>
                <i class="bi bi-trash me-1"></i> Depurar
              <% end %>
            </div>
          </div>
        <% end %>

      </div>

    <% end %>
  </div>
</turbo-frame>
