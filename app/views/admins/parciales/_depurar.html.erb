<turbo-frame id= 'contenido'>
  <%= turbo_stream_from 'nomina_channel' %>
  <%= content_tag :div,
                  class: "d-flex flex-column justify-content-center" do %>
    <% if cont < 2 %>
      <%= render "admins/parciales/no_opciones_disponibles" %>
    <% elsif cont >= 5 %>
      <div class="d-flex justify-content-center">
        <h5 class="col-md-5 text-success text-center">
          Depuración Terminada 
        </h5>
      </div>
    <% else %>
      <div class="d-flex justify-content-center">
        <h5 class="col-md-5 text-success text-center">
          Depuración en paso: <%= cont - 1 %> 
        </h5>
      </div>
    <% end %>
    <%= content_tag :ol, class: "d-flex flex-column gap-2" do %>
      <%if cont >= 2 %>
        <%= content_tag :li, id: "contenedor_boton_unicos" do %>
          <div class="d-flex flex-row gap-2">
            <%= button_to 'Sincronizar cargos únicos',
                          sincronizar_admins_path(tipo: 'unicos'),
                          disabled: !(cont.eql?(2)),
                          class: "btn btn-warning",
                          data: {
                                 disable_with: "Procesando...",
                                 turbo_submits_with: "Enviando..."
                          } %>
  
            <div id="progreso_cargos_unicos" class= "align-self-center">
              <% if cont > 2 %>
                <% mensaje = "✅ Sincronizacion Exitosa" %>
              <% end %>
              <%= mensaje %>
            </div>
          </div>
        <% end %>
      <% end %>
      <% if cont >= 3 %>
        <%= content_tag :li, id: "contenedor_boton_multiple" do %>
          <div class="d-flex flex-row gap-2">
            <%= button_to 'Detectar inconsistencias',
                          sincronizar_admins_path(tipo: 'multiple'),
                          disabled: !(cont.eql?(3)),
                          class: "btn btn-warning",
                          data: {
                                 disable_with: "Procesando...",
                                 turbo_submits_with: "Enviando..."
                          } %>
  
            <div id="progreso_cargos_multiple" class= "align-self-center">
              <% if cont > 3 %>
                <% mensaje = "✅" %>  
              <% end %>
              <%= mensaje %>
              <%= link_to("Manejar inconcistencias", vcm_admins_path) %>
            </div>
          </div>
        <% end %>
      <% end %>
      <% if cont >= 4 %>
        <%= content_tag :li, id: "contenedor_boton_inactivos" do %>
          <div class="d-flex flex-row gap-2">
            <%= button_to 'Depurar trabajadores inactivos',
                          sincronizar_admins_path(tipo: 'inactivos'),
                          disabled: !(cont.eql?(4)),
                          class: "btn btn-danger",
                          data: {
                                 confirm: "¿Está seguro de que desea eliminar todos los registros inactivos? Esta acción no se puede deshacer.",
                                 disable_with: "Procesando...",
                                 turbo_submits_with: "Enviando..."
                          } %>
            <div id="progreso_cargos_inactivos" class="align-self-center">
              <% if cont > 4 %>
                <% mensaje = "✅ Depuración completada" %>
              <% end %>
              <%= mensaje %>
            </div>
          </div>
        <% end %>
      <% end%>
    <% end %>
  <% end %>
</turbo-frame>
