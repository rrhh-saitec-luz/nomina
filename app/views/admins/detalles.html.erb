<%= turbo_frame_tag "remote_modal" do %>
<!-- Modal -->
<div class="modal fade" data-controller="modal" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel">Detalles del Cargo</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <% if @tipo.eql?(1) %>
          <%= render "admins/parciales/modal_detalle_cargos_sistema", detallado: @detallado %>
        <% else %>
          <%= render "admins/parciales/modal_detalle_cargos_prenomina", detallado: @detallado %>
        <% end %>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
<% end %>
