<%= turbo_frame_tag "remote_modal" do %>
<!-- Modal -->
<div class="modal fade" data-controller="modal" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel">Detalles del Cargo</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <%= content_tag :ul do %>
          <%= content_tag :li, class: "d-flex" do %>
            <h5 class="me-2">Cedula:</h5><%= @detallado.ce_trabajador %>
          <% end %>
          <%= content_tag :li, class: "d-flex" do %>
            <h5 class="me-2">Nombres:</h5><%= @detallado.nombres %>
          <% end %>
          <%= content_tag :li, class: "d-flex gap-2" do %>
            <h5>Ubicación:</h5><div><%= @detallado.co_ubicacion %></div>
            <h5>Tipo personal:</h5><%= @detallado.tipopersonal %>
          <% end %>
          <%= content_tag :li, class: "d-flex" do %>
            <h5 class="me-2">Estado cargo:</h5><%= @detallado.edo_cargo %>
          <% end %>
          <%= content_tag :li, class: "d-flex" do %>
            <h5 class="me-2">Estado trabajador:</h5><%= @detallado.estatus %>
          <% end %>
        <% end %>

        ...
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
<% end %>
