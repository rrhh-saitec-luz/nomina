<turbo-frame id="contenido">                                                          
  <%= turbo_stream_from 'nomina_channel' %>                                           
  <div id="contenido_formulario_nomina" class="card-body p-4">                        
    <% 
      # Programación defensiva para extraer el valor numérico del contador de forma segura
      fase_actual = @contador.respond_to?(:valor) ? @contador.valor.to_i : @contador.to_i
    %>
    <%# --- ENCABEZADO UNIFICADO --- %>                                             
    <div class="d-flex align-items-center gap-2 mb-4 pb-3 border-bottom <%= fase_actual >= 8 ? 'text-danger' : 'text-success' %>">                                            
      <i class="bi <%= fase_actual >= 8 ? 'bi-calendar-x-fill' : 'bi-play-circle-fill' %> fs-4"></i>                                                                           
      <h5 class="mb-0 fw-bold">Generar Nueva Prenómina Base</h5>          
    </div>                                                                            

    <%# 🌟 ESCENARIO A: EL PROCESO YA INICIÓ O ESTÁ CERRADO (Fase >= 1) %>
<% if fase_actual >= 1 %>                                                                                           
  
  <%# 🌟 EL CONTENEDOR PRINCIPAL: Si es >= 8 cambia a borde Rojo Danger con opacidad, si no, a Amarillo Warning %>
  <div class="text-center py-5 bg-light rounded-3 border <%= fase_actual >= 8 ? 'border-danger border-opacity-15' : 'border-warning border-opacity-15' %> mx-auto shadow-sm" style="max-width: 500px;">                                                      
                                                                                                                    
    <% if fase_actual >= 8 %>                                                                                       
      <div class="text-danger mb-3">                                                                               
        <i class="bi bi-shield-fill-check display-3 opacity-75"></i>                                                     
      </div>                                                                                                        
      <h5 class="fw-bold text-dark mb-1">Cierre de Período Consolidado</h5>                                         
      <p class="text-muted small mb-4 px-4">                                                                        
        La información fiscal de este mes ha sido migrada con éxito a <code>Concepto</code>. La tabla de trabajo ya puede ser vaciada de forma segura para abrir el ciclo del mes siguiente.                                                
      </p>                                                                                                          
    <% else %>                                                                                                      
      <div class="text-warning mb-3">                                                                               
        <i class="bi bi-exclamation-triangle-fill display-3 opacity-75"></i>                                        
      </div>                                                                                                        
      <h5 class="fw-bold text-dark mb-1">Proceso de Prenómina Activo</h5>                                           
      <p class="text-muted small mb-4 px-4">                                                                    
        El sistema detectó un cálculo base en la Fase <%= fase_actual %>. Para inicializar un proceso de datos completamente nuevo, es necesario remover la actual de la memoria volátil.                                                   
      </p>                                                                                                          
    <% end %>                

    <%# Contenedor del Botón Maestro de Destrucción Transaccional %>                                                
    <div class="d-flex flex-column align-items-center justify-content-center gap-3 px-4">                           
      <%= button_to destruir_prenomina_admins_path,                                                                 
                    method: :post,                                                                                  
                    class: "btn btn-danger px-4 py-2.5 fw-bold shadow-sm w-100 d-inline-flex align-items-center justify-content-center gap-2",                                                                                              
                    data: { turbo_confirm: fase_actual >= 8 ? "¿Desea vaciar el espacio de trabajo 'HistoricoPago' para dar inicio a un nuevo mes contable?" : "¿Está completamente seguro de eliminar la prenómina actual? Esta acción no se puede deshacer." } do %>                                                                                              
        <i class="bi bi-trash3-fill fs-5"></i>                                                                      
        <span><%= fase_actual >= 8 ? "Vaciar Canal y Reabrir Sistema" : "Eliminar Prenómina Activa" %></span>                                                                                                                                   
      <% end %>                                                                                                     
    </div>                                                                                                          
                                                                                                                    
    <%# 🌟 ETIQUETAS DE ESTADO UNIFICADAS E IDÉNTICAS A LA OTRA PANTALLA %>                                                                           
    <div class="d-flex justify-content-center gap-2 mt-4">                                                          
      <% if fase_actual >= 8 %>
        <%# Badge Rojo idéntico %>
        <span class="badge bg-danger-subtle text-danger border border-danger border-opacity-15 px-2.5 py-1.5 small fw-semibold">                                                                                                                  
          <i class="bi bi-lock-fill me-1"></i> Período Consolidado                                                    
        </span>
      <% else %>
        <%# Badge Amarillo idéntico %>
        <span class="badge bg-warning-subtle text-warning border border-warning border-opacity-15 px-2.5 py-1.5 small fw-semibold text-dark">                                                                                                 
          <i class="bi bi-hourglass-split me-1"></i> Esperando Reinicio                                             
        </span>
      <% end %>
      
      <%# Badge Gris de la fase unificado %>
      <span class="badge bg-light text-secondary border px-2 py-1.5 small fw-medium">                                                                                                                                                           
        Fase: <%= fase_actual %>                                                                                    
      </span>                                                                                                       
    </div>                                                                                                          
                                                                                                                    
  </div>

    <%# 🌟 ESCENARIO B: EL SISTEMA ESTÁ EN CERO (Fase 0) %>
    <% else %>

      <%= form_with url: prenomina_admins_path,                                       
                    method: :post,                                                    
                    class: "d-flex flex-column gap-3 mx-auto",                        
                    style: "max-width: 600px;",                                       
                    data: { controller: "admin", turbo_frame: "contenido" } do |form| %>

         <%# Sección de sub-parciales de configuración de campos %>                   
         <div class="card bg-light border-0 p-3 rounded-3 shadow-sm">                  
           <%= render "admins/parciales/gen_nom_meses", meses: @meses, years: @years, form: form %>                      
         </div>                                                                        

         <div class="card bg-light border-0 p-3 rounded-3 shadow-sm">                  
           <%= render "admins/parciales/gen_nom_nominas", nomina: @nomina, form: form %>                                   
         </div>                                                                        
                                                                                      
         <%# Fila de Acciones y Barra de Progreso %>                                   
         <div class="d-flex align-self-start gap-3 w-100 align-items-center mt-2">     
           <%= form.submit "Generar prenómina base",                                   
                           id: "boton_prenomina",                                      
                           class: "btn btn-success px-4 py-2.5 fw-bold shadow-sm",     
                           style: "background-color: #198754; border-color: #198754;", 
                           data: { turbo_submits_with: "Iniciando volcado..." } %>     
           
           <div id="progreso_cargos_creacion" class="align-self-center flex-grow-1"></div>
         </div>                                                                        
       <% end %>                                                                       
                                                                                      
       <%# Pie de página informativo %>                                                
       <div class="mt-4 pt-3 border-top mx-auto" style="max-width: 600px;">            
         <%= render "admins/parciales/gen_nom_footer" %>                               
       </div>                                                                          

     <% end %>                                                                         
  </div>                                                                              
</turbo-frame>

